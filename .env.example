 # =====================================================
# SmartCare ID - Environment Variables (Docker Compose)
# =====================================================
# Copy this file to ".env" and adjust as needed:
#   cp .env.example .env
# =====================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=smartcare_db
MYSQL_USER=smartcare
MYSQL_PASSWORD=smartcare
MYSQL_PORT=3306

# ---- Backend ----
BACKEND_PORT=9090
DDL_AUTO=update
SHOW_SQL=false
